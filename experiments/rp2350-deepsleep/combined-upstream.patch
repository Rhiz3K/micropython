+            raise OSError(16)
+
+        self.machine.deepsleep = busy
+        with self.assertRaises(SimulatedReset):
+            self.namespace["run"]()
+        self.assertEqual(busy_phases, [8])
+        self.assertEqual(self.state[3], 4)
